<launch>
  <arg name="host" default="192.168.144.25" description="SIYI device IP address" />
  <arg name="port" default="37260" />
  <arg name="transport" default="udp" />
  <arg name="attitude_stream_hz" default="10" />
  <arg name="auto_reconnect" default="false" />
  <arg name="publish_tf" default="false" description="Broadcast dynamic TF from tf_parent_frame to tf_child_frame" />
  <arg name="tf_parent_frame" default="base_link" description="Parent TF frame (vehicle body frame)" />
  <arg name="tf_child_frame" default="siyi_gimbal" description="Child TF frame (gimbal frame)" />
  <arg name="camera_model" default="zt30" description="Camera model key for RTSP URL" />
  <arg name="stream_index" default="0" />
  <arg name="backend" default="gstreamer" description="Video backend: gstreamer | opencv | aiortsp" />
  <arg name="publish_raw" default="true" />
  <arg name="publish_compressed" default="true" />
  <arg name="image_scale" default="1.0" />
  <arg name="jpeg_quality" default="80" />
  <arg name="latency_ms" default="0" />
  <arg name="namespace" default="" />
  <arg name="camera_name" default="siyi_camera" description="Camera name used by camera_info_manager" />
  <arg name="camera_info_url" default="" description="URL to camera calibration YAML loaded via camera_info_manager. Examples: file:///abs/path/calib.yaml  or package://siyi_ros2/config/calib.yaml. Leave empty to publish uncalibrated CameraInfo." />
  <arg name="zoom_threshold" default="0.1" description="Deadband on cmd_vel linear.x before the zoom is engaged" />
  <arg name="cmd_vel_timeout" default="0.2" description="Freeze the zoom when no cmd_vel arrives for this long (seconds)" />
  <arg name="zoom_rate_hz" default="3.5" description="How often the absolute zoom requests are sent (max 4 Hz)" />
  <arg name="zoom_service_timeout" default="2.0" description="Give up on an unanswered set_zoom request after this long (seconds)" />
  <arg name="max_zoom" default="6.0" description="Upper zoom bound (the driver accepts at most 30.0)" />
  <arg name="max_zoom_rate" default="3.0" description="Maximum rate of change of zoom level (levels per second)" />
  <arg name="initial_zoom" default="1.0" description="Zoom level the node assumes the camera starts at" />
  <arg name="pos_rate_hz" default="10.0" description="Frequency at which relative pose requests are sent" />
  <arg name="pos_max_rate" default="$(eval 'math.radians(30.0)')" description="Angular rate used to achieve relative pose target (rad/s)" />
  <arg name="pos_tolerance_deg" default="1.0" description="Pose error below which the requested pose is considered reached" />
  
  <set_env name="GST_DEBUG" value="0" />
  <set_env name="SIYI_LOG_LEVEL" value="WARNING" />
  <set_env name="SIYI_PROTOCOL_TRACE" value="0" />
  
  <node name="siyi_node" pkg="siyi_ros2" exec="siyi_node" namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share siyi_ros2)/config/siyi_params.yaml" />
    <param name="host" value="$(var host)" />
    <param name="port" value="$(var port)" />
    <param name="transport" value="$(var transport)" />
    <param name="attitude_stream_hz" value="$(var attitude_stream_hz)" />
    <param name="auto_reconnect" value="$(var auto_reconnect)" />
    <param name="publish_tf" value="$(var publish_tf)" />
    <param name="tf_parent_frame" value="$(var tf_parent_frame)" />
    <param name="tf_child_frame" value="$(var tf_child_frame)" />
    <!-- The driver has wrong pitch limits, the real pitch is -155 (looking down), flip -180->0, to 90 (looking up) -->
    <param name="pitch_min_deg" value="-180.0" />
    <param name="pitch_max_deg" value="180.0" />
  </node>

  <node name="siyi_camera_node" pkg="siyi_ros2" exec="siyi_camera_node" namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share siyi_ros2)/config/camera_params.yaml" />
    <param name="host" value="$(var host)" />
    <param name="camera_model" value="$(var camera_model)" />
    <param name="stream_index" value="$(var stream_index)" />
    <param name="backend" value="$(var backend)" />
    <param name="publish_raw" value="$(var publish_raw)" />
    <param name="publish_compressed" value="$(var publish_compressed)" />
    <param name="image_scale" value="$(var image_scale)" />
    <param name="jpeg_quality" value="$(var jpeg_quality)" />
    <param name="latency_ms" value="$(var latency_ms)" />
    <param name="camera_info_url" value="$(var camera_info_url)" />
    <param name="camera_name" value="$(var camera_name)" />
    <remap from="siyi/image_compressed" to="siyi/image/compressed" />
  </node>

  <node name="cmd_vel_to_gimbal" pkg="cras_siyi_driver" exec="cmd_vel_to_gimbal" namespace="$(var namespace)" output="screen">
    <param name="zoom_threshold" value="$(var zoom_threshold)" />
    <param name="cmd_vel_timeout" value="$(var cmd_vel_timeout)" />
    <param name="zoom_rate_hz" value="$(var zoom_rate_hz)" />
    <param name="zoom_service_timeout" value="$(var zoom_service_timeout)" />
    <param name="max_zoom" value="$(var max_zoom)" />
    <param name="max_zoom_rate" value="$(var max_zoom_rate)" />
    <param name="initial_zoom" value="$(var initial_zoom)" />
    <param name="pos_rate_hz" value="$(var pos_rate_hz)" />
    <param name="pos_max_rate" value="$(var pos_max_rate)" />
    <param name="pos_tolerance_deg" value="$(var pos_tolerance_deg)" />
  </node>
</launch>
