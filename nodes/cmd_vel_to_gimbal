import math

from geometry_msgs.msg import TwistStamped
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from siyi_msgs.msg import GimbalRateCmd
from siyi_msgs.srv import SetAbsoluteZoom

MIN_ZOOM = 1.0
MAX_ZOOM_LIMIT = 30.0


class CmdVelToGimbal(Node):

    def __init__(self, **kwargs) -> None:
        super().__init__('cmd_vel_to_gimbal', **kwargs)

        self.declare_parameter('zoom_threshold', 0.1)
        self.declare_parameter('rate_scale', 1.0)
        self.declare_parameter('cmd_vel_timeout', 0.2)
        self.declare_parameter('zoom_speed', 2.0)
        self.declare_parameter('zoom_rate_hz', 3.5)
        self.declare_parameter('zoom_service_timeout', 2.0)
        self.declare_parameter('max_zoom', MAX_ZOOM_LIMIT)
        self.declare_parameter('initial_zoom', MIN_ZOOM)

        self._cmd_vel_topic = 'siyi/cmd/cmd_vel'
        self._rate_topic = 'siyi/cmd/rate'
        self._zoom_service = 'siyi/set_zoom'

        self._zoom_threshold = float(self.get_parameter('zoom_threshold').value)
        self._rate_scale = float(self.get_parameter('rate_scale').value)
        self._cmd_vel_timeout = float(self.get_parameter('cmd_vel_timeout').value)
        self._zoom_speed = max(0.0, float(self.get_parameter('zoom_speed').value))
        self._zoom_rate_hz = min(4.0, max(0.5, float(self.get_parameter('zoom_rate_hz').value)))
        self._zoom_timeout = max(0.2, float(self.get_parameter('zoom_service_timeout').value))
        self._max_zoom = min(MAX_ZOOM_LIMIT, max(MIN_ZOOM, float(self.get_parameter('max_zoom').value)))

        self._zoom_target = self._clamp_zoom(float(self.get_parameter('initial_zoom').value))
        self._zoom_velocity = 0.0
        self._last_cmd_vel_time = None
        self._last_tick = None
        self._sent_zoom = None
        self._zoom_pending = False
        self._pending_since = None
        self._zoom_seq = 0
        self._resend_needed = False
        self._zoom_fails = 0
        self._next_retry_ns = 0

        self._rate_pub = self.create_publisher(GimbalRateCmd, self._rate_topic, qos_profile_sensor_data)
        self._zoom_client = self.create_client(SetAbsoluteZoom, self._zoom_service)
        self.create_subscription(TwistStamped, self._cmd_vel_topic, self._on_cmd_vel, qos_profile_sensor_data)
        self.create_timer(1.0 / self._zoom_rate_hz, self._on_zoom_tick)

        self.get_logger().info(
            f'{self._cmd_vel_topic} -> {self._rate_topic} + {self._zoom_service} '
            f'(zoom {MIN_ZOOM:.1f}-{self._max_zoom:.1f}x, {self._zoom_rate_hz:.1f} Hz, {self._zoom_speed:.1f}x/s)'
        )

    def _on_cmd_vel(self, msg: TwistStamped) -> None:
        rate = GimbalRateCmd()
        rate.header = msg.header
        rate.yaw_rate_dps = -float(math.degrees(msg.twist.angular.z) * self._rate_scale)
        rate.pitch_rate_dps = -float(math.degrees(msg.twist.angular.y) * self._rate_scale)
        self._rate_pub.publish(rate)

        zoom = float(msg.twist.linear.x)
        self._zoom_velocity = 0.0 if abs(zoom) <= self._zoom_threshold else max(-1.0, min(1.0, zoom))
        self._last_cmd_vel_time = self.get_clock().now()

    def _on_zoom_tick(self) -> None:
        now = self.get_clock().now()
        dt = 0.0 if self._last_tick is None else (now - self._last_tick).nanoseconds / 1e9
        self._last_tick = now
        dt = min(max(dt, 0.0), 4.0 / self._zoom_rate_hz)

        if self._zoom_velocity != 0.0 and self._last_cmd_vel_time is not None:
            if (now - self._last_cmd_vel_time).nanoseconds / 1e9 > self._cmd_vel_timeout:
                self._zoom_velocity = 0.0

        self._zoom_target = self._clamp_zoom(self._zoom_target + self._zoom_velocity * self._zoom_speed * dt)

        zoom = self._round_zoom(self._zoom_target)
        if self._zoom_pending and (now - self._pending_since).nanoseconds / 1e9 > self._zoom_timeout:
            self.get_logger().warn(
                f'{self._zoom_service} did not respond in {self._zoom_timeout:.1f} s', throttle_duration_sec=5.0
            )
            self._forget_zoom_call()
            self._note_zoom_failure()
        if self._zoom_pending:
            return
        if zoom == self._sent_zoom and (not self._resend_needed or now.nanoseconds < self._next_retry_ns):
            return

        if not self._zoom_client.service_is_ready():
            self._warn_service_unavailable()
            return

        self._send_zoom(zoom)

    def _clamp_zoom(self, zoom: float) -> float:
        return min(self._max_zoom, max(MIN_ZOOM, zoom))

    def _round_zoom(self, zoom: float) -> float:
        return round(self._clamp_zoom(zoom), 1)

    def _send_zoom(self, zoom: float) -> None:
        self._sent_zoom = zoom
        self._zoom_pending = True
        self._pending_since = self.get_clock().now()
        self._zoom_seq += 1
        request = SetAbsoluteZoom.Request()
        request.zoom_level = float(zoom)
        future = self._zoom_client.call_async(request)
        future.add_done_callback(lambda finished, seq=self._zoom_seq: self._on_zoom_done(finished, seq))

    def _on_zoom_done(self, future, seq: int) -> None:
        if seq != self._zoom_seq:
            return
        self._forget_zoom_call()
        try:
            response = future.result()
        except Exception as exc:
            self.get_logger().error(f'{self._zoom_service} call failed: {exc}', throttle_duration_sec=5.0)
            self._note_zoom_failure()
            return

        if not response.success:
            self.get_logger().warn(
                f'{self._zoom_service} rejected the command: {response.message}', throttle_duration_sec=5.0
            )
            self._note_zoom_failure()
        else:
            self._resend_needed = False
            self._zoom_fails = 0

    def _forget_zoom_call(self) -> None:
        self._zoom_pending = False
        self._pending_since = None

    def _note_zoom_failure(self) -> None:
        self._resend_needed = True
        self._zoom_fails += 1
        self._next_retry_ns = self.get_clock().now().nanoseconds + int(min(2.0 ** self._zoom_fails, 30.0) * 1e9)

    def _warn_service_unavailable(self) -> None:
        self.get_logger().warning(f'Service {self._zoom_service} is not available', throttle_duration_sec=5.0)


def main(args=None) -> None:
    rclpy.init(args=args)
    node = CmdVelToGimbal()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
